{
  "easycom": {
    "autoscan": false,
    "custom": {
      "^App(.*)": "@/components/App$1.vue"
    }
  },
  "pages": [
    {
      "path": "pages/index/index",
      "style": {
        "navigationBarTitleText": "企业贷款咨询"
      }
    },
    {
      "path": "pages/home/home",
      "style": {
        "navigationBarTitleText": "首页",
        "enablePullDownRefresh": false
      }
    },
    {
      "path": "pages/auth/auth",
      "style": {
        "navigationBarTitleText": "身份认证"
      }
    },
    {
      "path": "pages/match/match",
      "style": {
        "navigationBarTitleText": "智能匹配"
      }
    },
    {
      "path": "pages/report/list",
      "style": {
        "navigationBarTitleText": "我的报告",
        "enablePullDownRefresh": true
      }
    },
    {
      "path": "pages/report/detail",
      "style": {
        "navigationBarTitleText": "报告详情"
      }
    },
    {
      "path": "pages/mine/mine",
      "style": {
        "navigationBarTitleText": "我的"
      }
    },
    {
      "path": "pages/order/list",
      "style": {
        "navigationBarTitleText": "我的服务单",
        "enablePullDownRefresh": true
      }
    },
    {
      "path": "pages/order/detail",
      "style": {
        "navigationBarTitleText": "服务单详情"
      }
    },
    {
      "path": "pages/product/list",
      "style": {
        "navigationBarTitleText": "我的产品",
        "enablePullDownRefresh": true
      }
    },
    {
      "path": "pages/product/edit",
      "style": {
        "navigationBarTitleText": "录入产品"
      }
    },
    {
      "path": "pages/client/create",
      "style": {
        "navigationBarTitleText": "录入客户"
      }
    },
    {
      "path": "pages/approval/list",
      "style": {
        "navigationBarTitleText": "分配审批"
      }
    }
  ],
  "globalStyle": {
    "navigationBarTextStyle": "black",
    "navigationBarTitleText": "企业融资服务",
    "navigationBarBackgroundColor": "#FFFFFF",
    "backgroundColor": "#F5F6F8"
  }
}