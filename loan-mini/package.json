  },
  "devDependencies": {
    "@dcloudio/vite-plugin-uni": "3.0.0-4020420240722001",
    "@vitest/coverage-v8": "^2.1.9",
    "vite": "^5.2.0",
    "vitest": "^2.1.9"
  }
}
