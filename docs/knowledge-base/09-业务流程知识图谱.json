    { "id": "T_IB", "name": "t_industry_benchmark", "module": "M_DIAG", "fields": "dimensions+均值; IndustryBenchmarkService.avgByDimension(T1)" },
    { "id": "T_LEAD_EXT", "name": "t_lead_ent_ext", "module": "M_LEAD", "fields": "ent_name/credit_code/industry/found_years/annual_tax_amount/annual_invoice_amount(T4)" },
    { "id": "T_OCR", "name": "t_ocr_record", "module": "M_DIAG", "fields": "ocr_record_id/biz_code/extracted_fields/confidence; _ocrMeta.version 派生 materialVersion(T2)" },
    { "id": "T_CBF", "name": "t_client_business_fact", "module": "M_MATCH", "fields": "客户经营事实(诊断/匹配经营指标落库)" },
    { "id": "T_SA", "name": "t_service_attachment", "module": "M_DIAG", "fields": "id, order_no, client_profile_code, report_no(诊断补充材料场景), attachment_type, file_key, file_name, upload_staff_id, upload_time" }
  ],
  "statemachines": [
    { "id": "SM_MATCH", "name": "匹配结果态(totalResult)", "states": ["PASS", "CONDITION", "REJECT", "SKIP_SEGMENT_MISMATCH", "ERROR"] },
    { "id": "SM_PRODUCT", "name": "渠道产品状态机(C9)", "transitions": [
        { "from": "DRAFT", "to": "PENDING", "action": "submit" },
        { "from": "PENDING", "to": "DRAFT", "action": "revoke(即时)" },
        { "from": "PENDING", "to": "OK", "action": "运营终审通过" },
        { "from": "OK", "to": "PENDING_DELETE", "action": "delete-apply" },
        { "from": "PENDING_DELETE", "to": "OK", "action": "audit(reject)/delete-cancel" },
        { "from": "PENDING_DELETE", "to": "DELETED", "action": "audit(approve)物理删除+审计" }
    ] },
    { "id": "SM_ALLOC", "name": "客户归属流转(C2/C19)", "transitions": [
        { "from": "NONE", "to": "AUTO_CLAIMED", "action": "情形A:录入即归属/情形B有归属人自动归属" },
        { "from": "NONE", "to": "PENDING_APPROVAL", "action": "情形B无归宿申请分配" },
        { "from": "PENDING_APPROVAL", "to": "APPROVED", "action": "UA3审批通过→归属流转" },
        { "from": "PENDING_APPROVAL", "to": "REJECTED", "action": "UA3驳回(opinion必填)" }
    ] }
  ],
