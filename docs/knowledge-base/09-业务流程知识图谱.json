    { "id": "T_LEAD", "name": "t_lead", "module": "M_LEAD", "fields": "owner_staff_id(NULL=公海/渠道进公海), recorder_staff_id; source 字典含 CHANNEL(旧MINI废弃)" },
    { "id": "T_STAFF", "name": "t_staff", "module": "M_REPORT", "fields": "staff_code, staff_name(B4 staffName来源)" },
