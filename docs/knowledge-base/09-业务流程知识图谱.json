    { "id": "M_DIAG", "name": "经营诊断(C5)", "doc": "§7" },
    { "id": "M_ORDER", "name": "服务单/工单(C7)", "doc": "§8" },
    { "id": "M_CHANPROD", "name": "渠道产品管理(C9状态机)", "doc": "§9" },
    { "id": "M_INVITE", "name": "邀请绑定/推荐奖励", "doc": "§10" },
    { "id": "M_LEAD", "name": "线索录入", "doc": "§11" },
    { "id": "M_ALLOC", "name": "审批中心(统一,C22)", "doc": "§4.3/§13", "desc": "视图层统一、不建表；建表迁移列阶段四。ALLOCATION 仅 OPERATOR/SUPER_ADMIN/SUPER/BOSS 可审（不含 DEPT_MGR）；PRODUCT/DOWNLOAD 含 DEPT_MGR（白名单 loan.mini.approval.types=ALLOCATION 当前仅开 ALLOCATION）。" }
  ],
  "interfaces": [
    { "id": "A1", "method": "POST", "path": "/api/mini/auth/login", "module": "M_AUTH", "perm": "PUBLIC", "note": "微信code主通道；兼容开关开时{phone,code}短信登录；inviteCode绑定" },
