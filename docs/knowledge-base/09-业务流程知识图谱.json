  ],
  "modules": [
    { "id": "M_AUTH", "name": "登录/认证/企业认证", "doc": "§1", "entry": true },
    { "id": "M_NAV", "name": "角色化导航(TabBar)", "doc": "§2", "entry": true },
    { "id": "M_HOME", "name": "首页(角色化分流)", "doc": "§3" },
    { "id": "M_MATCH", "name": "智能匹配(含替客/归属流转)", "doc": "§4" },
    { "id": "M_REPORT", "name": "我的报告(角色二分查询)", "doc": "§5" },
