    { "id": "M4", "method": "POST", "path": "/api/mini/client", "module": "M_MATCH", "perm": "STAFF", "note": "录入新客户自动归属" },
    { "id": "M5", "method": "POST", "path": "/api/mini/client/{clientCode}/claim", "module": "M_ALLOC", "perm": "STAFF", "note": "申请分配 AUTO_CLAIMED/PENDING_APPROVAL" },
    { "id": "M6", "method": "GET", "path": "/api/mini/client/{clientCode}/claim-status", "module": "M_ALLOC", "perm": "STAFF", "note": "审批状态轮询" },
    { "id": "M7", "method": "GET", "path": "/api/mini/client/allocation-approvals/pending", "module": "M_ALLOC", "perm": "OPERATOR/SUPER/BOSS", "note": "⚠️ 已废弃(兼容期) → 改用 UA2（统一审批待审列表）" },
    { "id": "M8", "method": "POST", "path": "/api/mini/client/allocation-approvals/{approvalNo}/approve", "module": "M_ALLOC", "perm": "OPERATOR/SUPER/BOSS", "note": "⚠️ 已废弃(兼容期) → 改用 UA3（统一审批 audit）" },
    { "id": "M9", "method": "POST", "path": "/api/mini/client/allocation-approvals/{approvalNo}/reject", "module": "M_ALLOC", "perm": "OPERATOR/SUPER/BOSS", "note": "⚠️ 已废弃(兼容期) → 改用 UA3（统一审批 audit，opinion 必填）" },
    { "id": "R1i", "method": "GET", "path": "/api/mini/report/list", "module": "M_REPORT", "perm": "角色二分", "note": "四维筛选（客户仅日期）" },
    { "id": "R2i", "method": "GET", "path": "/api/mini/report/{reportNo}", "module": "M_REPORT", "perm": "CUSTOMER校验归属/STAFF全量", "note": "报告详情" },
    { "id": "R3i", "method": "GET", "path": "/api/mini/report/{reportNo}/products", "module": "M_PRODUCTS", "perm": "仅STAFF", "note": "命中产品明细(C4)" },
    { "id": "R4i", "method": "GET", "path": "/api/mini/report/{reportNo}/diagnosis", "module": "M_DIAG", "perm": "CUSTOMER(own)/STAFF", "note": "经营诊断(C5)" },
    { "id": "O1", "method": "GET", "path": "/api/mini/order/list", "module": "M_ORDER", "perm": "角色二分", "note": "四维筛选(C7)" },
    { "id": "O2", "method": "GET", "path": "/api/mini/order/{orderNo}", "module": "M_ORDER", "perm": "CUSTOMER(own)/STAFF", "note": "工单详情" },
    { "id": "P1", "method": "GET", "path": "/api/mini/product/list", "module": "M_CHANPROD", "perm": "CHANNEL", "note": "我的产品(沙箱自有)" },
    { "id": "P2", "method": "POST", "path": "/api/mini/product", "module": "M_CHANPROD", "perm": "CHANNEL", "note": "保存草稿" },
    { "id": "P3", "method": "GET", "path": "/api/mini/product/{code}", "module": "M_CHANPROD", "perm": "CHANNEL", "note": "详情" },
    { "id": "P4", "method": "PUT", "path": "/api/mini/product/{code}", "module": "M_CHANPROD", "perm": "CHANNEL", "note": "编辑" },
    { "id": "P5", "method": "POST", "path": "/api/mini/product/{code}/submit", "module": "M_CHANPROD", "perm": "CHANNEL", "note": "提交审批" },
    { "id": "P6", "method": "POST", "path": "/api/mini/product/{code}/revoke", "module": "M_CHANPROD", "perm": "CHANNEL", "note": "撤销审批→DRAFT" },
    { "id": "P7", "method": "POST", "path": "/api/mini/product/{code}/delete-apply", "module": "M_CHANPROD", "perm": "CHANNEL", "note": "申请删除" },
    { "id": "P8", "method": "POST", "path": "/api/mini/product/{code}/delete-cancel", "module": "M_CHANPROD", "perm": "CHANNEL", "note": "撤销删除" },
    { "id": "P9", "method": "GET", "path": "/api/mini/partner-product/delete/pending", "module": "M_CHANPROD", "perm": "OPERATOR/SUPER/BOSS", "note": "待删列表" },
    { "id": "P10", "method": "POST", "path": "/api/mini/partner-product/delete/{approvalNo}/audit", "module": "M_CHANPROD", "perm": "OPERATOR/SUPER/BOSS", "note": "终审删除" },
    { "id": "I1", "method": "POST", "path": "/api/mini/invitation/bind", "module": "M_INVITE", "perm": "CUSTOMER", "note": "补绑邀请码" },
    { "id": "I2", "method": "GET", "path": "/api/mini/invitation/mine", "module": "M_INVITE", "perm": "CUSTOMER", "note": "我的邀请码" },
    { "id": "I3", "method": "GET", "path": "/api/mini/invitation/records", "module": "M_INVITE", "perm": "CUSTOMER", "note": "邀请记录" },
    { "id": "W1", "method": "GET", "path": "/api/mini/reward/mine/summary", "module": "M_INVITE", "perm": "CUSTOMER", "note": "奖励汇总" },
    { "id": "W2", "method": "GET", "path": "/api/mini/reward/mine", "module": "M_INVITE", "perm": "CUSTOMER", "note": "奖励记录" },
    { "id": "L1", "method": "POST", "path": "/api/mini/lead/submit", "module": "M_LEAD", "perm": "LOGIN(含CHANNEL)", "note": "线索录入；body 新增企业字段 entName/creditCode/industry/foundYears/annualTaxAmount/annualInvoiceAmount(可选)；source 后端按用户类型派生(CHANNEL→公海/BOSS→BOSS/其他STAFF→ADVISER/CUSTOMER→VIP，旧MINI废弃)；响应 Result<Map>{leadNo,duplicated}" },
    { "id": "L2", "method": "GET", "path": "/api/mini/lead/my", "module": "M_LEAD", "perm": "LOGIN", "note": "我录入的线索；PageResult<Map>{leadNo,contactName(脱敏),entName,phone(掩码),followStatus,createdAt}，仅本人" },
    { "id": "UA1", "method": "GET", "path": "/api/mini/approval/counts", "module": "M_ALLOC", "perm": "OPERATOR/SUPER_ADMIN/SUPER/BOSS", "note": "统一审批计数 PRODUCT/DOWNLOAD/ALLOCATION/TOTAL（白名单仅开 ALLOCATION）" },
    { "id": "UA2", "method": "GET", "path": "/api/mini/approval/pending", "module": "M_ALLOC", "perm": "OPERATOR/SUPER_ADMIN/SUPER/BOSS", "note": "统一待审列表(type=ALL 按 createdAt 归并分段；白名单仅开 ALLOCATION)" },
    { "id": "UA3", "method": "POST", "path": "/api/mini/approval/{type}/{approvalNo}/audit", "module": "M_ALLOC", "perm": "OPERATOR/SUPER_ADMIN/SUPER/BOSS(ALLOCATION 不含 DEPT_MGR)", "note": "统一审批 通过/驳回 body{approve,opinion}" },
    { "id": "AA1", "method": "GET", "path": "/api/admin/approval/allocation/pending", "module": "M_ALLOC", "perm": "OPERATOR/SUPER/BOSS/DEPT_MANAGER", "note": "管理端 allocation 待审" },
    { "id": "AA2", "method": "POST", "path": "/api/admin/approval/allocation/{approvalNo}/audit", "module": "M_ALLOC", "perm": "OPERATOR/SUPER/BOSS/DEPT_MANAGER", "note": "管理端 allocation 终审" },
    { "id": "AA3", "method": "GET", "path": "/api/admin/approval/counts", "module": "M_ALLOC", "perm": "OPERATOR/SUPER/BOSS", "note": "管理端统一计数" },
    { "id": "AA4", "method": "GET", "path": "/api/admin/approval/pending", "module": "M_ALLOC", "perm": "OPERATOR/SUPER/BOSS", "note": "管理端统一待审?type=..." }
