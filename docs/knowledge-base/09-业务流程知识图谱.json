    { "id": "M1", "method": "POST", "path": "/api/mini/match/run", "module": "M_MATCH", "perm": "CUSTOMER/STAFF;CHANNEL禁", "note": "发起匹配；员工必传clientCode" },
    { "id": "M2", "method": "GET", "path": "/api/mini/match/history", "module": "M_MATCH", "perm": "CUSTOMER", "note": "我的匹配历史" },
