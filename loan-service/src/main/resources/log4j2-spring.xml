<?xml version="1.0" encoding="UTF-8"?>
<!--
  Log4j2 日志配置：按日志性质拆分为 5 类文件 + 敏感信息脱敏 + traceId 串联

  分包约定（对齐《前后端小程序代码与交互优化计划》阶段2 P1）：
    biz.log          业务日志（com.loan 全量，debug 及以上）
    error.log        错误日志（error 级别，跨所有分包汇总）
    access.log       访问日志（接口耗时/HTTP状态/业务code/traceId，由 AccessLogFilter 输出到 ACCESS_LOG）
    sql.log          慢查询日志（Druid 慢 SQL，logger root 为 com.alibaba.druid）
    integration.log  外部调用日志（微信/短信/OSS 等第三方边界）

  脱敏：文件型 appender 统一由 SensitiveRewritePolicy 包装，落盘前重写消息体，
        覆盖 token/密码/手机号/身份证/统一社会信用代码/银行卡号。
        控制台不脱敏，便于本地调试（控制台不落盘）。

  ⚠️ 两处硬约束（改动前必读）：
    1. packages="com.loan.infrastructure.logging" —— Log4j2 靠它扫描 @Plugin 注解的脱敏组件，
       删除或写错包名会导致启动报 "Unable to locate plugin for SensitiveRewritePolicy"。
    2. traceId 只能写 %X{traceId}，不要写成 %X{traceId:-none} —— log4j2 会把 "traceId:-none"
       整体当作 key 查找，导致请求日志的 traceId 恒为空（2026-09-06 已踩坑）。
       启动期日志无请求上下文，traceId 为空属正常；请求日志由 TraceIdFilter 写入。
-->
<Configuration status="WARN" packages="com.loan.infrastructure.logging">
    <Properties>
        <Property name="LOG_PATTERN">%d{yyyy-MM-dd HH:mm:ss.SSS} [%thread] [traceId=%X{traceId}] %-5level %logger{36} - %msg%n</Property>
        <!-- access 日志自包含 traceId，无需 %X，格式更紧凑便于按列解析 -->
        <Property name="ACCESS_PATTERN">%d{yyyy-MM-dd HH:mm:ss.SSS} %-5level - %msg%n</Property>
        <!-- 后台启动由 LOAN_LOG_DIR 指定绝对目录；未设置时仍兼容本地前台运行。 -->
        <Property name="LOG_DIR">${env:LOAN_LOG_DIR:-logs}</Property>
    </Properties>

    <Appenders>
        <Console name="Console" target="SYSTEM_OUT">
            <PatternLayout pattern="${LOG_PATTERN}"/>
        </Console>

        <!-- ============ 业务日志 ============ -->
        <RollingFile name="BizFile" fileName="${LOG_DIR}/biz.log"
                     filePattern="${LOG_DIR}/archive/%d{yyyy-MM-dd}-loan-platform-service-biz-%i.log.gz">
            <PatternLayout pattern="${LOG_PATTERN}"/>
            <Policies>
                <TimeBasedTriggeringPolicy interval="1" modulate="true"/>
                <SizeBasedTriggeringPolicy size="100 MB"/>
            </Policies>
            <DefaultRolloverStrategy max="30">
                <Delete basePath="${LOG_DIR}/archive" maxDepth="1">
                    <IfFileName glob="*-loan-platform-service-biz-*.log.gz"/>
                    <IfLastModified age="30d"/>
                </Delete>
            </DefaultRolloverStrategy>
        </RollingFile>

        <!-- ============ 错误日志 ============ -->
        <RollingFile name="ErrorFile" fileName="${LOG_DIR}/error.log"
                     filePattern="${LOG_DIR}/error/%d{yyyy-MM-dd}-loan-platform-service-error-%i.log.gz">
            <ThresholdFilter level="error" onMatch="ACCEPT" onMismatch="DENY"/>
            <PatternLayout pattern="${LOG_PATTERN}"/>
            <Policies>
                <TimeBasedTriggeringPolicy interval="1" modulate="true"/>
                <SizeBasedTriggeringPolicy size="100 MB"/>
            </Policies>
            <DefaultRolloverStrategy max="30">
                <Delete basePath="${LOG_DIR}/error" maxDepth="1">
                    <IfFileName glob="*-loan-platform-service-error-*.log.gz"/>
                    <IfLastModified age="30d"/>
                </Delete>
            </DefaultRolloverStrategy>
        </RollingFile>

        <!-- ============ 访问日志 ============ -->
        <RollingFile name="AccessFile" fileName="${LOG_DIR}/access.log"
                     filePattern="${LOG_DIR}/archive/%d{yyyy-MM-dd}-loan-platform-service-access-%i.log.gz">
            <PatternLayout pattern="${ACCESS_PATTERN}"/>
            <Policies>
                <TimeBasedTriggeringPolicy interval="1" modulate="true"/>
                <SizeBasedTriggeringPolicy size="100 MB"/>
            </Policies>
            <DefaultRolloverStrategy max="30">
                <Delete basePath="${LOG_DIR}/archive" maxDepth="1">
                    <IfFileName glob="*-loan-platform-service-access-*.log.gz"/>
                    <IfLastModified age="30d"/>
                </Delete>
            </DefaultRolloverStrategy>
        </RollingFile>

        <!-- ============ 慢查询日志 ============ -->
        <RollingFile name="SqlFile" fileName="${LOG_DIR}/sql.log"
                     filePattern="${LOG_DIR}/archive/%d{yyyy-MM-dd}-loan-platform-service-sql-%i.log.gz">
            <PatternLayout pattern="${LOG_PATTERN}"/>
            <Policies>
                <TimeBasedTriggeringPolicy interval="1" modulate="true"/>
                <SizeBasedTriggeringPolicy size="50 MB"/>
            </Policies>
            <DefaultRolloverStrategy max="15">
                <Delete basePath="${LOG_DIR}/archive" maxDepth="1">
                    <IfFileName glob="*-loan-platform-service-sql-*.log.gz"/>
                    <IfLastModified age="15d"/>
                </Delete>
            </DefaultRolloverStrategy>
        </RollingFile>

        <!-- ============ 外部调用日志 ============ -->
        <RollingFile name="IntegrationFile" fileName="${LOG_DIR}/integration.log"
                     filePattern="${LOG_DIR}/archive/%d{yyyy-MM-dd}-loan-platform-service-integration-%i.log.gz">
            <PatternLayout pattern="${LOG_PATTERN}"/>
            <Policies>
                <TimeBasedTriggeringPolicy interval="1" modulate="true"/>
                <SizeBasedTriggeringPolicy size="50 MB"/>
            </Policies>
            <DefaultRolloverStrategy max="15">
                <Delete basePath="${LOG_DIR}/archive" maxDepth="1">
                    <IfFileName glob="*-loan-platform-service-integration-*.log.gz"/>
                    <IfLastModified age="15d"/>
                </Delete>
            </DefaultRolloverStrategy>
        </RollingFile>

        <!-- ============ 脱敏包装：重写消息后交给目标 appender ============ -->
        <Rewrite name="RewriteBiz">
            <SensitiveRewritePolicy/>
            <AppenderRef ref="BizFile"/>
        </Rewrite>
        <Rewrite name="RewriteError">
            <SensitiveRewritePolicy/>
            <AppenderRef ref="ErrorFile"/>
        </Rewrite>
        <Rewrite name="RewriteIntegration">
            <SensitiveRewritePolicy/>
            <AppenderRef ref="IntegrationFile"/>
        </Rewrite>
        <!-- access 日志含请求 URI，可能携带手机号/token 等查询参数，同样必须脱敏 -->
        <Rewrite name="RewriteAccess">
            <SensitiveRewritePolicy/>
            <AppenderRef ref="AccessFile"/>
        </Rewrite>
    </Appenders>

    <Loggers>
        <!-- 访问日志：独立 logger，不向父级传递，避免混入 biz.log -->
        <Logger name="ACCESS_LOG" level="info" additivity="false">
            <AppenderRef ref="RewriteAccess"/>
        </Logger>

        <!-- 慢查询：Druid 慢 SQL 与连接池统计。additivity=false，不进 biz.log -->
        <Logger name="com.alibaba.druid" level="info" additivity="false">
            <AppenderRef ref="SqlFile"/>
            <AppenderRef ref="RewriteError"/>
        </Logger>

        <!-- 外部调用：additivity=true，既进 integration.log 专属文件，也保留在 biz.log 的完整上下文里 -->
        <Logger name="com.loan.wechat" level="debug" additivity="true">
            <AppenderRef ref="RewriteIntegration"/>
        </Logger>
        <Logger name="com.loan.sms" level="debug" additivity="true">
            <AppenderRef ref="RewriteIntegration"/>
        </Logger>
        <Logger name="com.loan.oss" level="debug" additivity="true">
            <AppenderRef ref="RewriteIntegration"/>
        </Logger>

        <!-- 业务主包 -->
        <Logger name="com.loan" level="debug" additivity="false">
            <AppenderRef ref="Console"/>
            <AppenderRef ref="RewriteBiz"/>
            <AppenderRef ref="RewriteError"/>
        </Logger>

        <Root level="info">
            <AppenderRef ref="Console"/>
            <AppenderRef ref="RewriteBiz"/>
            <AppenderRef ref="RewriteError"/>
        </Root>
    </Loggers>
</Configuration>
